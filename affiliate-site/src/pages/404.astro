---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 4);
---

<Base
  title="페이지를 찾을 수 없어요 (404) - BabyGrade"
  description="요청하신 페이지가 존재하지 않거나 이동되었어요. 인기 글이나 카테고리에서 원하시는 정보를 찾아보세요."
  ogType="website"
>
  <section class="nf">
    <div class="nf-inner">
      <p class="nf-code">404</p>
      <h1>찾으시는 페이지가 없어요 👶</h1>
      <p class="nf-lead">URL이 변경되었거나, 삭제된 페이지일 수 있어요.<br />아래 인기 글이나 카테고리에서 다시 찾아보세요.</p>

      <nav class="nf-cta" aria-label="추천 경로">
        <a href="/" class="btn primary">홈으로</a>
        <a href="/category/신생아/" class="btn">신생아</a>
        <a href="/category/안전/" class="btn">안전 인증</a>
        <a href="/about/" class="btn">소개</a>
      </nav>

      {posts.length > 0 && (
        <section class="nf-posts">
          <h2>인기 글</h2>
          <ul>
            {posts.map((p) => (
              <li>
                <a href={`/${p.id}/`}>
                  <span class="cat">{p.data.category}</span>
                  <span class="ttl">{p.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </section>
</Base>

<style>
  .nf { padding: 60px 24px; min-height: 60vh; }
  .nf-inner { max-width: 720px; margin: 0 auto; text-align: center; }
  .nf-code {
    font-size: 4rem; font-weight: 800; color: var(--primary);
    margin-bottom: 8px; line-height: 1;
  }
  .nf h1 { font-size: 1.6rem; margin-bottom: 14px; }
  .nf-lead { color: var(--muted); line-height: 1.7; margin-bottom: 28px; }
  .nf-cta { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 40px; }
  .btn {
    display: inline-block; padding: 10px 18px; border: 1px solid var(--border);
    border-radius: 999px; font-size: .9rem; color: var(--text); background: #fff;
    text-decoration: none; font-weight: 600;
  }
  .btn:hover { background: #fff5e6; text-decoration: none; }
  .btn.primary { background: var(--primary); color: #fff; border-color: var(--primary); }
  .btn.primary:hover { background: var(--primary-dark); }
  .nf-posts { text-align: left; max-width: 560px; margin: 0 auto; }
  .nf-posts h2 { font-size: 1rem; color: var(--muted); margin-bottom: 12px; text-transform: uppercase; letter-spacing: .04em; }
  .nf-posts ul { list-style: none; padding: 0; margin: 0; }
  .nf-posts li { border-bottom: 1px solid var(--border); }
  .nf-posts a { display: flex; gap: 12px; align-items: center; padding: 12px 0; color: var(--text); text-decoration: none; }
  .nf-posts a:hover .ttl { color: var(--primary-dark); }
  .nf-posts .cat {
    background: #fff5e6; color: var(--primary-dark);
    font-size: .72rem; padding: 2px 8px; border-radius: 12px; font-weight: 600; flex-shrink: 0;
  }
  .nf-posts .ttl { font-size: .95rem; line-height: 1.4; }
</style>
