# 로컬 실행용 템플릿. 실제 값은 content-pipeline/.env 에 넣는다(.gitignore 로 보호됨).
# 클라우드 자동 발행(.github/workflows/daily-publish.yml)은 이 파일을 쓰지 않고
# 같은 이름의 GitHub Secret 을 환경변수로 주입한다. 키를 추가하면 양쪽 다 등록할 것.

# Coupang Partners API (https://partners.coupang.com/)
COUPANG_ACCESS_KEY=your-access-key
COUPANG_SECRET_KEY=your-secret-key

# Cloudflare Workers 배포 (https://dash.cloudflare.com/profile/api-tokens)
CLOUDFLARE_API_TOKEN=your-cf-token

# IndexNow key (파일명: affiliate-site/public/{KEY}.txt 과 일치해야 함)
INDEXNOW_KEY=your-indexnow-key

# ── 이미지 = Replicate Flux Schnell 전용 ────────────────────
# 🚫 Gemini 금지 (2026-07-28 사용자 재확인). GEMINI_API_KEY 는 등록하지 않는다 —
#    등록하면 generate-images.js 의 Gemini 프롬프트 합성 경로가 되살아난다.
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxx
IMAGE_PROVIDER=replicate
REPLICATE_MODEL=black-forest-labs/flux-schnell
